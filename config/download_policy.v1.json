{
  "policy_version": "1.0.0",
  "mission": "ROMAN",
  "domain": "ASTRONOMICAL_OBSERVATORY",
  "default_mode": "METADATA_ONLY",
  "automatic_product_downloads_enabled": false,
  "external_download_scripts_execute_automatically": false,
  "max_public_page_bytes": 8388608,
  "max_auto_download_bytes": 250000000,
  "daily_download_budget_bytes": 1000000000,
  "max_mast_observation_rows": 25,
  "max_mast_product_rows": 100,
  "unknown_schema_action": "UNKNOWN_QUARANTINE",
  "restricted_source_action": "METADATA_ONLY",
  "large_product_action": "REQUIRE_MANUAL_APPROVAL",
  "duplicate_action": "VERIFY_EXISTING_HASH",
  "partial_download_action": "DELETE_AND_RECORD_FAILURE",
  "checksum_algorithm": "SHA-256",
  "allowed_hosts": [
    "science.nasa.gov",
    "www.jpl.nasa.gov",
    "www.stsci.edu",
    "stsci.edu",
    "archive.stsci.edu",
    "mast.stsci.edu",
    "roman.ipac.caltech.edu",
    "roman-docs.stsci.edu",
    "roman.science.stsci.edu",
    "github.com",
    "api.github.com",
    "raw.githubusercontent.com",
    "corgisim.readthedocs.io",
    "www.romancoronagraph.space",
    "romancoronagraph.space",
    "data.science.stsci.edu",
    "zenodo.org"
  ],
  "automatic_blocked_suffixes": [
    ".fits",
    ".fit",
    ".fts",
    ".asdf",
    ".h5",
    ".hdf5",
    ".zarr",
    ".parquet",
    ".tar",
    ".tar.gz",
    ".tgz",
    ".zip",
    ".7z"
  ],
  "blocked_destination_domains": [
    "SUN_EARTH_L1_SPACE_WEATHER",
    "PLASMA_PIPELINE",
    "CHI_B24M",
    "GANNON_HOLDOUT"
  ]
}
